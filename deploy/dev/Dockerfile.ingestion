# ==============================================================================
# Image ingestion (Airflow) có DqrColumnSqlValidator cho kiểm thử theo quy tắc CLDL.
# Chồng validator lên image ingestion gốc, không build lại cả Airflow.
# Build từ thư mục gốc của repo:  deploy/dev/build-ingestion-image.sh
# Image: openmetadata/ingestion:custom-1.13.3
# ==============================================================================
ARG BASE_IMAGE=docker.getcollate.io/openmetadata/ingestion:1.13.3
FROM ${BASE_IMAGE}

COPY ingestion/src/metadata/data_quality/validations/column/sqlalchemy/dqrColumnSqlValidator.py /tmp/dqrColumnSqlValidator.py
COPY deploy/dev/patch-ingestion-dqr.py /tmp/patch-ingestion-dqr.py

RUN python /tmp/patch-ingestion-dqr.py \
 && python -c "import metadata.data_quality.validations.column.sqlalchemy.dqrColumnSqlValidator" \
 && rm /tmp/dqrColumnSqlValidator.py /tmp/patch-ingestion-dqr.py
