# ==============================================================================
# 🐳 Dockerfile for OpenMetadata Custom Frontend (Nginx)
# Image: openmetadata/frontend:custom-1.13.3
# ==============================================================================

# Production Stage: Dùng Nginx Alpine siêu nhẹ
FROM nginx:alpine

# Copy static assets (được build từ openmetadata-ui/src/main/resources/ui/dist)
COPY openmetadata-ui/src/main/resources/ui/dist /usr/share/nginx/html

# Copy file cấu hình Nginx
COPY deploy/dev/nginx.conf /etc/nginx/conf.d/default.conf

# Thay thế các biến placeholder của Java Backend trong index.html
RUN sed -i 's|\${basePath}|/|g' /usr/share/nginx/html/index.html && \
    sed -i 's|\${cspNonce}||g' /usr/share/nginx/html/index.html && \
    sed -i 's|\${clusterName}|openmetadata|g' /usr/share/nginx/html/index.html && \
    sed -i 's|\${appVersion}|1.13.3|g' /usr/share/nginx/html/index.html && \
    sed -i 's|\${sentryEnabled}|false|g' /usr/share/nginx/html/index.html && \
    sed -i 's|\${sentryDsn}||g' /usr/share/nginx/html/index.html && \
    sed -i 's|\${sentryEnvironment}||g' /usr/share/nginx/html/index.html && \
    sed -i 's|\${sentryTraceSampleRate}|0|g' /usr/share/nginx/html/index.html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
