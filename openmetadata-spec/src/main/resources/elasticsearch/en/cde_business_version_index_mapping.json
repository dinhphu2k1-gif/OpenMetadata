{
  "settings": {
    "analysis": {
      "normalizer": {
        "cde_lowercase": { "type": "custom", "filter": ["lowercase", "asciifolding"] }
      },
      "analyzer": {
        "cde_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": true,
    "properties": {
      "rowKey": { "type": "keyword" },
      "termId": { "type": "keyword" },
      "glossaryId": { "type": "keyword" },
      "parentBusinessVersion": { "type": "keyword" },
      "businessVersion": { "type": "keyword" },
      "businessVersionSortKey": { "type": "keyword" },
      "recordType": { "type": "keyword" },
      "scopeType": { "type": "keyword" },
      "entityStatus": { "type": "keyword" },
      "cdeSort": {
        "properties": {
          "normalizedName": { "type": "keyword" },
          "displayName": { "type": "keyword" },
          "businessVersion": { "type": "keyword" },
          "entityStatus": { "type": "keyword" }
        }
      },
      "name": {
        "type": "text",
        "analyzer": "cde_text",
        "fields": { "keyword": { "type": "keyword", "normalizer": "cde_lowercase" } }
      },
      "normalizedName": { "type": "keyword" },
      "displayName": {
        "type": "text",
        "analyzer": "cde_text",
        "fields": { "keyword": { "type": "keyword", "normalizer": "cde_lowercase" } }
      },
      "description": { "type": "text", "analyzer": "cde_text" },
      "domainIds": { "type": "keyword" },
      "ownerIds": { "type": "keyword" },
      "reviewerIds": { "type": "keyword" },
      "dataSourceTags": { "type": "keyword" },
      "classificationTags": { "type": "keyword" },
      "publishedAt": { "type": "date", "format": "epoch_millis" },
      "updatedAt": { "type": "date", "format": "epoch_millis" }
    }
  }
}
