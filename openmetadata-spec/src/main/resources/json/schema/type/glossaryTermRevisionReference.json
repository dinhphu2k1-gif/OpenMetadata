{
  "$id": "https://open-metadata.org/schema/type/glossaryTermRevisionReference.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GlossaryTermRevisionReference",
  "description": "Exact glossary term revision included in a glossary working version or published snapshot.",
  "javaType": "org.openmetadata.schema.type.GlossaryTermRevisionReference",
  "type": "object",
  "properties": {
    "termId": {
      "$ref": "basic.json#/definitions/uuid"
    },
    "termSnapshotId": {
      "$ref": "basic.json#/definitions/uuid"
    },
    "termBusinessVersion": {
      "type": "string"
    },
    "termNativeVersion": {
      "$ref": "entityHistory.json#/definitions/entityVersion"
    },
    "parentTermSnapshotId": {
      "$ref": "basic.json#/definitions/uuid"
    },
    "displayOrder": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["termId", "termSnapshotId", "termBusinessVersion", "termNativeVersion"],
  "additionalProperties": false
}
