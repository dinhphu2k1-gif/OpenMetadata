{
  "$id": "https://open-metadata.org/schema/api/data/cdeDraftUpdateRequest.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CdeDraftUpdateRequest",
  "description": "Complete mutable payload used to save a CDE working Draft.",
  "javaType": "org.openmetadata.schema.api.data.CdeDraftUpdateRequest",
  "type": "object",
  "properties": {
    "expectedRevision": { "type": "integer", "minimum": 1 },
    "displayName": { "type": ["string", "null"] },
    "description": { "$ref": "../../type/basic.json#/definitions/markdown" },
    "owners": { "$ref": "../../type/entityReferenceList.json" },
    "domains": { "$ref": "../../type/entityReferenceList.json" },
    "tags": {
      "type": "array",
      "items": { "$ref": "../../type/tagLabel.json" }
    },
    "relatedTerms": {
      "description": "Read-only related terms carried forward while saving a governed working Draft.",
      "type": "array",
      "items": { "$ref": "../../type/termRelation.json" }
    },
    "extension": {
      "oneOf": [
        { "$ref": "../../type/basic.json#/definitions/entityExtension" },
        { "type": "null" }
      ]
    },
    "dataQualityTestSpecs": {
      "description": "Test declarations of a Data Quality Rule working Draft. Rejected for Data Dictionary terms.",
      "$ref": "../../type/dqTestSpecs.json"
    }
  },
  "required": [
    "expectedRevision",
    "description",
    "owners",
    "domains",
    "tags"
  ],
  "additionalProperties": false
}
