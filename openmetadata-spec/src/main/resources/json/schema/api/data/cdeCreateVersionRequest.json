{
  "$id": "https://open-metadata.org/schema/api/data/cdeCreateVersionRequest.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CdeCreateVersionRequest",
  "description": "Request to create the next working business version of an approved CDE.",
  "javaType": "org.openmetadata.schema.api.data.CdeCreateVersionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["businessVersion"],
  "properties": {
    "businessVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "maxLength": 64
    }
  }
}
