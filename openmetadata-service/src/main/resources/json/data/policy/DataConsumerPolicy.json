{
  "name": "DataConsumerPolicy",
  "displayName": "Data Consumer Policy",
  "fullyQualifiedName": "DataConsumerPolicy",
  "description": "Strict Least-Privilege Read-Only Policy for Data Consumer (Internal Viewer): Full read-only view of business & technical assets. Explicit Deny on all mutations and platform administration.",
  "enabled": true,
  "allowDelete": false,
  "provider": "system",
  "rules": [
    {
      "name": "DataConsumer-ViewAllRule",
      "description": "Allow read-only view on all metadata assets",
      "resources": [
        "all"
      ],
      "operations": [
        "ViewAll",
        "ViewBasic"
      ],
      "effect": "allow"
    },
    {
      "name": "DataConsumer-ViewCollaborationRule",
      "description": "Allow read-only view on discussion feeds and threads",
      "resources": [
        "feed",
        "thread"
      ],
      "operations": [
        "ViewAll",
        "ViewBasic"
      ],
      "effect": "allow"
    },
    {
      "name": "DataConsumer-DenyUnapprovedGlossaryTerms",
      "description": "Deny viewing glossary terms that are not in Approved status",
      "resources": [
        "glossaryTerm"
      ],
      "operations": [
        "ViewAll",
        "ViewBasic"
      ],
      "effect": "deny",
      "condition": "neverApproved()"
    },
    {
      "name": "DataConsumer-DenyAllNonReadOperations",
      "description": "Explicitly deny all mutating, editing, deleting, deploying, and triggering operations when not owner",
      "resources": [
        "all"
      ],
      "operations": [
        "AuditLogs",
        "BulkCreate",
        "BulkUpdate",
        "Create",
        "CreateIngestionPipelineAutomator",
        "CreateScim",
        "CreateTests",
        "Delete",
        "DeleteScim",
        "DeleteTestCaseFailedRowsSample",
        "Deploy",
        "EditAll",
        "EditCertification",
        "EditCustomFields",
        "EditDataProfile",
        "EditDescription",
        "EditDisplayName",
        "EditEntityRelationship",
        "EditGlossaryTerms",
        "EditIngestionPipelineStatus",
        "EditKnowledgePanel",
        "EditLifeCycle",
        "EditLineage",
        "EditOwners",
        "EditPage",
        "EditPolicy",
        "EditQueries",
        "EditReviewers",
        "EditRole",
        "EditSampleData",
        "EditScim",
        "EditStatus",
        "EditTags",
        "EditTeams",
        "EditTestDefinitionLibrary",
        "EditTests",
        "EditTier",
        "EditUsage",
        "EditUserNotificationTemplate",
        "EditUsers",
        "GenerateToken",
        "Impersonate",
        "Kill",
        "Trigger"
      ],
      "effect": "deny",
      "condition": "!isOwner()"
    },
    {
      "name": "DataConsumer-DenyAdminAndSecurityResources",
      "description": "Explicitly deny access to platform security, roles, policies, bots, and app definitions",
      "resources": [
        "agentExecution",
        "app",
        "appMarketPlaceDefinition",
        "auditLog",
        "bot",
        "eventsubscription",
        "ingestionPipeline",
        "mcpExecution",
        "mcpServer",
        "mcpService",
        "notificationTemplate",
        "policy",
        "queryCostRecord",
        "role",
        "securityService",
        "type"
      ],
      "operations": [
        "All"
      ],
      "effect": "deny"
    },
    {
      "name": "DataConsumer-DenyDangerousGlobalOps",
      "description": "Explicitly deny token generation, SCIM manipulation, role modification, and impersonation",
      "resources": [
        "all"
      ],
      "operations": [
        "CreateScim",
        "DeleteScim",
        "EditPolicy",
        "EditRole",
        "EditScim",
        "EditTeams",
        "EditUsers",
        "GenerateToken",
        "Impersonate"
      ],
      "effect": "deny"
    }
  ]
}