{
  "name": "BasicConsumerPolicy",
  "displayName": "Basic Consumer Policy",
  "fullyQualifiedName": "BasicConsumerPolicy",
  "description": "Strict Least-Privilege Read-Only Policy for Basic Consumer (Business User): Whitelist read-only access to Business Glossaries & Quality Rules. Explicit Deny on all technical infrastructure and mutations.",
  "enabled": true,
  "allowDelete": false,
  "provider": "system",
  "rules": [
    {
      "name": "BasicConsumerPolicy-ViewBusinessMetadata",
      "description": "Allow read-only view on business metadata, domains, and data quality rules",
      "resources": [
        "classification",
        "dataProduct",
        "document",
        "domain",
        "glossary",
        "glossaryTerm",
        "persona",
        "tag",
        "team",
        "testCase",
        "testSuite",
        "user"
      ],
      "operations": [
        "ViewAll",
        "ViewBasic"
      ],
      "effect": "allow"
    },
    {
      "name": "BasicConsumerPolicy-DenyUnapprovedGlossaryTerms",
      "description": "Deny viewing glossary terms that are not in Approved status",
      "resources": [
        "glossaryTerm"
      ],
      "operations": [
        "ViewAll",
        "ViewBasic"
      ],
      "effect": "deny",
      "condition": "notApproved()"
    },
    {
      "name": "BasicConsumerPolicy-DenyNonReadOperations",
      "description": "Explicitly deny all mutating operations on allowed business resources when not owner",
      "resources": [
        "classification",
        "dataProduct",
        "document",
        "domain",
        "glossary",
        "glossaryTerm",
        "persona",
        "tag",
        "team",
        "testCase",
        "testSuite",
        "user"
      ],
      "operations": [
        "AuditLogs",
        "BulkCreate",
        "BulkUpdate",
        "Create",
        "CreateIngestionPipelineAutomator",
        "CreateScim",
        "CreateTests",
        "Delete",
        "DeleteScim",
        "DeleteTestCaseFailedRowsSample",
        "Deploy",
        "EditAll",
        "EditCertification",
        "EditCustomFields",
        "EditDataProfile",
        "EditDescription",
        "EditDisplayName",
        "EditEntityRelationship",
        "EditGlossaryTerms",
        "EditIngestionPipelineStatus",
        "EditKnowledgePanel",
        "EditLifeCycle",
        "EditLineage",
        "EditOwners",
        "EditPage",
        "EditPolicy",
        "EditQueries",
        "EditReviewers",
        "EditRole",
        "EditSampleData",
        "EditScim",
        "EditStatus",
        "EditTags",
        "EditTeams",
        "EditTestDefinitionLibrary",
        "EditTests",
        "EditTier",
        "EditUsage",
        "EditUserNotificationTemplate",
        "EditUsers",
        "GenerateToken",
        "Impersonate",
        "Kill",
        "Trigger"
      ],
      "effect": "deny",
      "condition": "!isOwner()"
    },
    {
      "name": "BasicConsumerPolicy-DenyNonBusinessResources",
      "description": "Explicitly deny all operations on technical infrastructure, services, tables, pipelines, and admin resources",
      "resources": [
        "agentExecution",
        "aiApplication",
        "aiGovernancePolicy",
        "apiCollection",
        "apiEndpoint",
        "apiService",
        "app",
        "appMarketPlaceDefinition",
        "auditLog",
        "bot",
        "chart",
        "container",
        "dashboard",
        "dashboardDataModel",
        "dashboardService",
        "dataContract",
        "dataInsightChart",
        "dataInsightCustomChart",
        "database",
        "databaseSchema",
        "databaseService",
        "directory",
        "driveService",
        "entityProfile",
        "entityReportData",
        "eventsubscription",
        "feed",
        "file",
        "ingestionPipeline",
        "intakeForm",
        "kpi",
        "learningResource",
        "llmModel",
        "llmService",
        "mcpExecution",
        "mcpServer",
        "mcpService",
        "messagingService",
        "metadataService",
        "metric",
        "mlmodel",
        "mlmodelService",
        "notificationTemplate",
        "pipeline",
        "pipelineService",
        "policy",
        "promptTemplate",
        "query",
        "queryCostRecord",
        "report",
        "role",
        "searchIndex",
        "searchService",
        "securityService",
        "spreadsheet",
        "storageService",
        "storedProcedure",
        "suggestion",
        "table",
        "task",
        "testCaseDimensionResult",
        "testCaseResolutionStatus",
        "testCaseResult",
        "testConnectionDefinition",
        "testDefinition",
        "thread",
        "topic",
        "type",
        "webAnalyticEvent",
        "workflow",
        "workflowDefinition",
        "workflowInstance",
        "workflowInstanceState",
        "worksheet"
      ],
      "operations": [
        "All"
      ],
      "effect": "deny"
    },
    {
      "name": "BasicConsumerPolicy-DenyDangerousGlobalOps",
      "description": "Explicitly deny token generation, SCIM manipulation, role modification, and impersonation",
      "resources": [
        "all"
      ],
      "operations": [
        "CreateScim",
        "DeleteScim",
        "EditPolicy",
        "EditRole",
        "EditScim",
        "EditTeams",
        "EditUsers",
        "GenerateToken",
        "Impersonate"
      ],
      "effect": "deny"
    }
  ]
}
