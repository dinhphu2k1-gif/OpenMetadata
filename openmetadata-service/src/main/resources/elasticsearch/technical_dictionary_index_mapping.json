      "description": {
        "type": "text"
      },
      "sourceStatus": {
        "type": "keyword"
      },
      "dataDictionaryVersion": {
        "type": "keyword"
      },
      "revision": {
        "type": "long"
      },
      "cde": {
        "properties": {
          "id": {
            "type": "keyword"
          },
          "code": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer",
            "fields": {
              "ngram": {
                "type": "text",
                "analyzer": "om_ngram"
              }
            }
          },
          "name": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer",
