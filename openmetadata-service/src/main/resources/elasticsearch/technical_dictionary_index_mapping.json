{
  "settings": {
    "index": {
      "max_ngram_diff": 7,
      "max_result_window": 10000
    },
    "analysis": {
      "char_filter": {
        "vietnamese_d": {
          "type": "mapping",
          "mappings": [
            "đ => d",
            "Đ => d"
          ]
        }
      },
      "filter": {
        "governance_ascii": {
          "type": "asciifolding",
          "preserve_original": false
        }
      },
      "tokenizer": {
        "governance_ngram_tokenizer": {
          "type": "ngram",
          "min_gram": 3,
          "max_gram": 10,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      },
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "char_filter": [
            "vietnamese_d"
          ],
          "filter": [
            "lowercase",
            "governance_ascii"
          ]
        }
      },
      "analyzer": {
        "governance_ngram": {
          "type": "custom",
          "char_filter": [
            "vietnamese_d"
          ],
          "tokenizer": "governance_ngram_tokenizer",
          "filter": [
            "lowercase",
            "governance_ascii"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "properties": {
      "termId": {
        "type": "keyword"
      },
      "columnKey": {
        "type": "keyword"
      },
      "columnFqn": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "governance_ngram"
          }
        }
      },
      "service": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "governance_ngram"
          }
        }
      },
      "database": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "governance_ngram"
          }
        }
      },
      "schema": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "governance_ngram"
          }
        }
      },
      "table": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "governance_ngram"
          }
        }
      },
      "column": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "governance_ngram"
          }
        }
      },
      "tableKey": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "dataType": {
