{
  "settings": {
    "index": {
      "max_ngram_diff": 7,
      "max_result_window": 10000
    },
    "analysis": {
      "tokenizer": {
        "n_gram_tokenizer": {
          "type": "ngram",
          "min_gram": 3,
          "max_gram": 10,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      },
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "char_filter": [],
          "filter": [
            "lowercase"
          ]
        }
      },
      "analyzer": {
        "om_ngram": {
          "type": "custom",
          "tokenizer": "n_gram_tokenizer",
          "filter": [
            "lowercase"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "properties": {
      "termId": {
        "type": "keyword"
      },
      "columnKey": {
        "type": "keyword"
      },
      "columnFqn": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "om_ngram"
          }
        }
      },
      "service": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "om_ngram"
          }
        }
      },
      "database": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "om_ngram"
          }
        }
      },
      "schema": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "om_ngram"
          }
        }
      },
      "table": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "om_ngram"
          }
        }
      },
      "column": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
